node_modules/

# Generated Hardhat / Vite output (recreated by compile / build)
artifacts/
cache/
types/
dist/

# Python environment and generated bytecode
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/

# Local environment settings; keep the submission template
.env
.env.*
!.env.example

# Local Ganache blockchain data
.ganache/

# Temporary tooling and browser-test output
.tmp_pdf_lib/
test-results/
playwright-report/
reports/browser/

# Old verification reports from an incomplete run
reports/
test-ui/

# Local logs
*.log

# Submission files are intentionally NOT ignored:
# contracts/, scripts/, test/, frontend/, screenshots/
# frontend/public/contract.json (actual project path)
# frontend/contract.json (if the project layout changes)
# reports/python-demo.json, reports/deployment.json, reports/demo.json
# README.md, requirements.txt, package-lock.json and project configs
