{
  "name": "apartment-maintenance-requests",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test mocha",
    "test:ganache": "hardhat test mocha --network ganache",
    "ganache": "node scripts/ganache.mjs",
    "deploy": "hardhat run scripts/deploy.ts --network ganache",
    "demo": "hardhat run scripts/demo.ts --network ganache",
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "verify:local": "node scripts/verify-local.mjs",
    "test:ui": "playwright test"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox-mocha-ethers": "4.0.0",
    "@playwright/test": "^1.65.1",
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.0.0",
    "chai": "^6.3.0",
    "dotenv": "^17.0.0",
    "ganache": "7.9.2",
    "hardhat": "3.22.0",
    "mocha": "^12.0.3",
    "typescript": "^5.9.0",
    "vite": "8.3.8"
  },
  "dependencies": {
    "ethers": "^6.16.0"
  }
}
